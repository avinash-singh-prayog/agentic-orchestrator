{
    "name": "Logistics Supervisor Agent",
    "description": "Orchestrates logistics operations using multi-agent coordination with LangGraph ReAct pattern. Routes requests to specialized booking and serviceability agents.",
    "version": "1.0.0",
    "schema_version": "0.8.0",
    "authors": [
        "Avinash <avinash@prayog.com>"
    ],
    "created_at": "2024-12-28T00:00:00Z",
    "skills": [
        {
            "name": "natural_language_processing/natural_language_understanding/contextual_comprehension",
            "id": 10101
        },
        {
            "name": "natural_language_processing/analytical_reasoning/problem_solving",
            "id": 10702
        },
        {
            "name": "natural_language_processing/natural_language_generation/dialogue_generation",
            "id": 10204
        }
    ],
    "domains": [
        {
            "name": "transportation/logistics",
            "id": 801
        },
        {
            "name": "technology/workflow_automation",
            "id": 11002
        }
    ],
    "locators": [
        {
            "type": "source_code",
            "url": "https://github.com/avinash-singh-prayog/agentic-orchestrator/tree/main/src/orchestrator/supervisor_agent"
        }
    ],
    "modules": [
        {
            "type": "a2a",
            "data": {
                "protocol": "SLIM",
                "description": "Agent-to-Agent communication via SLIM transport layer",
                "connected_agents": [
                    {
                        "name": "booking_agent",
                        "endpoint": "slim://booking-agent:8765",
                        "purpose": "Order creation, retrieval, and cancellation"
                    },
                    {
                        "name": "serviceability_agent",
                        "endpoint": "slim://serviceability-agent:8765",
                        "purpose": "Route validation and rate fetching"
                    }
                ]
            }
        },
        {
            "type": "model",
            "data": {
                "provider": "litellm",
                "model_name": "configurable via SUPERVISOR_MODEL env var",
                "default_model": "openrouter/google/gemini-2.0-flash-exp:free",
                "temperature": 0,
                "max_tokens": null,
                "features": [
                    "tool_calling",
                    "streaming"
                ]
            }
        },
        {
            "type": "observability",
            "data": {
                "enabled": true,
                "provider": "ioa_observe",
                "decorators": [
                    "@agent",
                    "@graph"
                ],
                "tracing": {
                    "enabled": true,
                    "exporter": "opentelemetry"
                }
            }
        }
    ]
}
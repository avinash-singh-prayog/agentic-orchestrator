pipeline {
    agent any

    parameters {
        string(
            name: 'VITE_ORCHESTRATOR_API_URL',
            defaultValue: 'https://prod-apis.prayog.io',
            description: 'Production API URL for the supervisor agent. Default: https://prod-apis.prayog.io'
        )
    }

    environment {
        AWS_ACCOUNT_ID = '084375559937'
        AWS_REGION     = 'ap-south-1'
        S3_BUCKET      = 'pinelabs-frontend'
        CLOUDFRONT_ID  = 'E29AQVB9X1DUQS'
        AWS_CREDS_ID   = 'prayog-prod-aws'
    }

    tools {
        nodejs 'node18'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Install') {
            steps {
                dir('src/frontend') {
                    script {
                        // Get the API URL from parameter or environment variable
                        def apiUrl = params.VITE_ORCHESTRATOR_API_URL?.trim() ?: env.VITE_ORCHESTRATOR_API_URL?.trim() ?: ''
                        
                        echo "=========================================="
                        echo "Checking VITE_ORCHESTRATOR_API_URL"
                        echo "Parameter value: '${params.VITE_ORCHESTRATOR_API_URL}'"
                        echo "Environment value: '${env.VITE_ORCHESTRATOR_API_URL ?: 'NOT SET'}'"
                        echo "Final value: '${apiUrl}'"
                        echo "=========================================="
                        
                        if (!apiUrl || apiUrl == '') {
                            error("""
                                ❌ VITE_ORCHESTRATOR_API_URL is not set!
                                
                                Please provide it in one of these ways:
                                1. Set it as a build parameter when triggering the build
                                2. Set it as a global environment variable in Jenkins:
                                   Manage Jenkins → Configure System → Global properties → Environment variables
                                   
                                The URL should point to your production supervisor agent API.
                                Example: https://your-api-gateway-url.com or http://your-alb-url:3044
                                
                                To find your production API URL:
                                - Check your ECS service for ALB/load balancer URL
                                - Check API Gateway if you're using one
                                - Or use the direct ECS service endpoint if exposed
                            """)
                        }
                        
                        echo "✅ Building with VITE_ORCHESTRATOR_API_URL=${apiUrl}"
                        
                        // Pass the API URL to the build script
                        withEnv(["VITE_ORCHESTRATOR_API_URL=${apiUrl}"]) {
                            sh '''
                                export HOME=$(pwd)

                                echo "Node version:"
                                node -v
                                echo "NPM version:"
                                npm -v

                                echo "=========================================="
                                echo "Building frontend with:"
                                echo "VITE_ORCHESTRATOR_API_URL=$VITE_ORCHESTRATOR_API_URL"
                                echo "=========================================="

                                npm install
                                npm run build
                                
                                echo "✅ Build completed successfully"
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy to S3') {
            steps {
                dir('src/frontend') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: AWS_CREDS_ID,
                         accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                         secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                    ]) {
                        sh '''
                            export AWS_DEFAULT_REGION=ap-south-1
                            echo "Deploying to S3..."
                            aws s3 sync dist/ s3://pinelabs-frontend --delete
                        '''
                    }
                }
            }
        }

        stage('Invalidate CloudFront') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: AWS_CREDS_ID,
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {
                    sh '''
                        export AWS_DEFAULT_REGION=ap-south-1
                        echo "Invalidating CloudFront cache..."
                        aws cloudfront create-invalidation \
                          --distribution-id E29AQVB9X1DUQS \
                          --paths "/*"
                    '''
                }
            }
        }
    }
}

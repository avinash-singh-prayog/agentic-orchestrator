# Development Procfile
# Use with: foreman start -f Procfile.dev
# Or: overmind start -f Procfile.dev

frontend: cd src/frontend && npm run dev
supervisor: cd src/orchestrator/supervisor_agent && source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 3044 --reload
transaction-rca: cd src/orchestrator/transaction_rca_agent && source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 3045 --reload

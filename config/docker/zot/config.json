{
    "distSpecVersion": "1.1.0-dev",
    "storage": {
        "rootDirectory": "/var/lib/registry",
        "dedupe": false,
        "gc": true,
        "gcDelay": "1h",
        "gcInterval": "24h"
    },
    "http": {
        "address": "0.0.0.0",
        "port": "5000",
        "auth": null,
        "accessControl": {
            "repositories": {
                "**": {
                    "anonymousPolicy": [
                        "read",
                        "create",
                        "update",
                        "delete"
                    ]
                }
            }
        }
    },
    "extensions": {
        "ui": {
            "enable": true
        },
        "search": {
            "enable": true
        },
        "scrub": {
            "enable": true,
            "interval": "24h"
        },
        "metrics": {
            "enable": true,
            "prometheus": {
                "path": "/metrics"
            }
        },
        "lint": {
            "enable": true
        }
    },
    "log": {
        "level": "info"
    }
}